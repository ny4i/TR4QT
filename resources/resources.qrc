<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <file>icons/tr4qt.png</file>
        <file>icons/tr4qt.ico</file>
        <file alias="icon_256x256.png">icons/tr4qt.iconset/icon_256x256.png</file>
    </qresource>
    <qresource prefix="/data">
        <file alias="schema.sql">../src/data/schema.sql</file>
        <file alias="global_schema.sql">../src/data/global_schema.sql</file>
        <file alias="arrl_sections.geojson">arrl_sections.geojson</file>
        <file alias="us_states.geojson">us_states.geojson</file>
    </qresource>
    <qresource prefix="/maps">
        <file alias="leaflet.js">maps/leaflet.js</file>
        <file alias="leaflet.css">maps/leaflet.css</file>
        <file alias="qwebchannel.js">maps/qwebchannel.js</file>
        <file alias="images/layers.png">maps/images/layers.png</file>
        <file alias="images/layers-2x.png">maps/images/layers-2x.png</file>
        <file alias="images/marker-icon.png">maps/images/marker-icon.png</file>
        <file alias="images/marker-icon-2x.png">maps/images/marker-icon-2x.png</file>
        <file alias="images/marker-shadow.png">maps/images/marker-shadow.png</file>
        <file alias="sections_map_standalone.html">maps/sections_map_standalone.html</file>
        <file alias="states_map_standalone.html">maps/states_map_standalone.html</file>
    </qresource>
</RCC>
